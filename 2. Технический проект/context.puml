Rel(User_Auth, auth_provider, "Аутентификация", "HTTP/2, WebSockets")
Rel(Guest, auth_provider, "Аутентификация", "HTTP/2")

Rel(hotel_system, message_provider, "Оповещение", "HTTP/2")
Rel(hotel_system, pay_provider, "Оплата", "REST API")
Rel(hotel_system, ai_recomendation_provider, "Поиск рекомендаций", "REST API")
Rel(hotel_system, sms_serivce, "Поиск рекомендаций", "REST API")
Rel(hotel_system, auth_provider, "Аутентификация", "OAuth 2.0, REST API")
Rel(hotel_system, backup_storage, "Резервное хранение данных", "HTTP/2")
Rel(hotel_system, hotel_provider, "Передача данных отеля", "HTTP/2")
Rel(hotel_system, location_provider, "Показ местонаходжения отеля", "HTTP/2")


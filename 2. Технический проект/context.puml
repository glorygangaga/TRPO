System(hotel_system, "Система бронирования отелей", "Веб-приложение", "Next.js, NestJS, PostgeSQL, Redis, Docker, RabbitMQ")

System_Ext(auth_provider, "OAuth Provider (Yandex, Гос. услуги)", "Аутентификация пользователей", "OAuth 2.0")
